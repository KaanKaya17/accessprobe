{
  "name": "rlsprobe",
  "version": "0.1.0",
  "description": "Prove your Supabase RLS actually works: signs up two test users and checks whether user B can read, change or delete user A's data. Evidence, not guesses — plus fix SQL and a ready-to-paste AI prompt.",
  "type": "module",
  "bin": {
    "rlsprobe": "bin/rlsprobe.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo:server": "node test/mock-supabase.js",
    "demo": "node bin/rlsprobe.js --site http://localhost:54399 --yes"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "supabase",
    "rls",
    "row-level-security",
    "security",
    "scanner",
    "vibe-coding",
    "lovable",
    "idor"
  ],
  "license": "MIT"
}
