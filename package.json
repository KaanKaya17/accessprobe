{
  "name": "rlsprobe",
  "version": "0.3.0",
  "description": "Prove your Supabase RLS and Firebase Security Rules actually work: two real test users, user B tries to read, change, forge and delete user A's data. Evidence, not guesses — plus fixes and a ready-to-paste AI prompt.",
  "type": "module",
  "bin": {
    "rlsprobe": "bin/rlsprobe.js"
  },
  "files": [
    "bin",
    "src",
    "integrations",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "demo:server": "node test/mock-supabase.js",
    "demo": "node bin/rlsprobe.js --site http://localhost:54399 --yes"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "supabase",
    "firebase",
    "firestore",
    "rls",
    "row-level-security",
    "security-rules",
    "security",
    "scanner",
    "idor",
    "vibe-coding",
    "lovable"
  ],
