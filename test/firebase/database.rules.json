{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "open": {
      ".read": true,
      ".write": true
    },
    "backups": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null"
      }
    }
  }
}
