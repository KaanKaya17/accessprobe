{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "open": {
      ".read": true,
      ".write": true
    },
    "scores": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['score', 'nickname']) && newData.child('score').isNumber()"
      }
    },
    "invites": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "backups": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null"
      }
    }
  }
}
