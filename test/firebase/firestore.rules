rules_version = '2';
// Fake app for accessprobe tests. Mixes deliberate real-world mistakes with correct rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }

    // LEAK: any signed-in user can read every profile. Writes are owner-only.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // LEAK + FORGERY: any signed-in user reads all orders and may create an
    // order with any userId. Update/delete are owner-only.
    match /orders/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // CORRECT: owner-only on field ownerId.
    match /notes/{id} {
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // INTENDED PUBLIC: anyone reads, only the owner writes.
    match /public_posts/{id} {
      allow read: if true;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // WIDE OPEN.
    match /logs/{id} {
      allow read, write: if true;
    }

    // TAKEOVER: update only checks the NEW owner value, so anyone can reassign a doc to itself.
    match /claims/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // CORRECT: per-user private subcollection.
    match /users/{uid}/private/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // CORRECT + VALIDATOR: owner-only and schema-checked.
    match /strict/{id} {
      allow read, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerId', 'title'])
        && request.resource.data.title is string;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerId', 'title'])
        && request.resource.data.title is string;
    }

    // ESCALATION: members/{uid}.role == 'admin' unlocks admin_reports, but users may
    // write every field of their own members document, role included.
    match /members/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /admin_reports/{id} {
      allow read: if isAdmin();
    }

    // CORRECT: same pattern, but users cannot touch isStaff.
    match /staff/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['isStaff']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isStaff']);
    }
    match /staff_area/{id} {
      allow read: if get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.isStaff == true;
    }
  }
}
